# Local configuration file
# This file should *NOT* be checked into Version Control System

# Location of the SDK (auto-generated by Android Studio)
# sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk

# Release signing configuration
# Copy this file to local.properties and fill in your actual values
# local.properties is in .gitignore and will NOT be committed to version control
SIGNING_STORE_PASSWORD=your_keystore_password_here
SIGNING_KEY_PASSWORD=your_key_password_here
